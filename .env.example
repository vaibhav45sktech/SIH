# =====================================================================
# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#     cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# NOTIFIER - which delivery channel to use
# ---------------------------------------------------------------------
# console  (DEFAULT) prints messages to the terminal. Nothing is delivered.
# whatsapp           sends via Twilio to REAL phone numbers.
# telegram           sends via a Telegram bot (fallback channel).
#
# Leave this unset or set to console until you intend to message real people.
# An unknown value falls back to console rather than escalating.
NOTIFIER=console

# ---------------------------------------------------------------------
# Twilio / WhatsApp - required ONLY when NOTIFIER=whatsapp
# ---------------------------------------------------------------------
# From the Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The WhatsApp sender. For the Twilio sandbox this is their shared number:
#   TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# For production, your own approved WhatsApp sender.
# The "whatsapp:" prefix is added automatically if you omit it.
TWILIO_WHATSAPP_FROM=

# SANDBOX NOTE: each recipient must send the join phrase (e.g. "join fresh-air")
# to the sandbox number, and that session expires after 24 hours of silence.
# Once it lapses, Twilio error 63016 is returned and the RECIPIENT must
# re-join. Re-running dispatch will not fix it.

# ---------------------------------------------------------------------
# Telegram - required ONLY when NOTIFIER=telegram
# ---------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram addresses chats by chat_id, not phone number, so a map is needed.
# The farmer must message the bot once before a chat_id exists.
# Inline JSON:
#   TELEGRAM_CHAT_MAP={"+919876543210": "123456789"}
# Or point at a JSON file:
#   TELEGRAM_CHAT_MAP_FILE=config/telegram_chats.json
TELEGRAM_CHAT_MAP=

# ---------------------------------------------------------------------
# Analysis pipeline (optional overrides - defaults are in config.py)
# ---------------------------------------------------------------------
# DATA_MODE=db
# DB_PATH=groundwater_data.db
# TREND_WINDOW_DAYS=3650
# SEASONAL_WINDOW_DAYS=365
